create table cashiers(
	cashier_id SERIAL primary key,
	full_name VARCHAR(60), 
	wage DECIMAL(10, 2),
	code INT UNIQUE,
	is_active BOOLEAN
)
;

create table client_types(
	client_type_id SERIAL primary key,
	client_type_name VARCHAR(20), 
	client_discount DECIMAL(10, 2)
)
;

create table order_statuses(
	status_id serial primary key,
	status_name VARCHAR(20) unique
)

create table orders(
	order_id SERIAL primary key,
	time TIMESTAMP default CURRENT_TIMESTAMP,
	client_type INT references client_types(client_type_id),
	wishes VARCHAR(200),
	type_of_pay VARCHAR(30),
	cashier INT references cashiers(cashier_id),
	status_of_order INT references order_statuses(status_id),
	total_cost DECIMAL(10, 2)
)
;

create table menu(
	dish_id SERIAL primary key,
	name_of_dish VARCHAR(80), 
	price DECIMAL(10, 2),
	dish_discount DECIMAL(5, 2),
	dish_category VARCHAR(50),
	is_available BOOLEAN DEFAULT TRUE
)
;


create table order_items(
	order_detail_id SERIAL primary key,
	order_id INT references orders(order_id),
	menu_item_id INT references menu(dish_id), 
	amount INT,
	price_at_order DECIMAL(10, 2)
)
;

